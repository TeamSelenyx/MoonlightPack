{
  "namespace": "storage_management",

  "storage_management_setting_section": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "storage_management_button_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "section_content": {
          "type": "stack_panel",
          "size": [ "100% - 8px", "100% - 4px" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "orientation": "horizontal",
          "controls": [
            {
              "sidebar_panel": {
                "type": "panel",
                "size": [ "32.5%", "100%" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "sidebar@facelift_setting_utils.facelift_content_panel_base": {
                      "$show_content_background": false,
                      "$section_panel_size": [ "100%", "100%" ],
                      "$section_content": "storage_management.storage_sidebar_panel"
                    }
                  }
                ]
              }
            },
			{ "void_panel@common.empty_panel": { "size": [ 4, 0 ] } },
            {
              "content_panel": {
                "type": "image",
                "size": [ "fill", "100%" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "texture": "textures/ui/hud_tip_text_background",
                "alpha": 0.6,
                "controls": [
                  {
                    "storage_management_setting_section@facelift_setting_utils.facelift_content_panel_base": {
                      "$show_content_background": false,
                      "$section_panel_size": [ "100% - 8px", "100% - 8px" ],
                      "$section_header_content": "storage_management.storage_header_panel",
                      "$section_content": "storage_management.storage_main_panel",
                      "$section_footer_content": "storage_management.storage_footer_panel"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },


  "storage_main_panel": {
    "type": "panel",
    "size": [ "100% - 1px", "100%c" ],
    "offset": [ -1, 0 ],
    "controls": [
      {
        "scroll_content@storage_management.storage_scroll_pane": {}
      }
    ]
  },

  "storage_sidebar_panel": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "$spatialPatternsPadding": [ "100%", 8 ],
    "$paddingLineDivider": [ "100%", 16 ],
    "controls": [
      {
        "header_panel": {
          "type": "stack_panel",
          "size": [ "100%", "100%c" ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            {
              "file_storage_dropdown_panel@facelift_setting_utils.settings_content_background_base": {
                "ignored": "($is_holographic and $is_reality_mode)",
                "visible": "(not $gear_vr)",
                "$content_controls": [
                  {
                    "file_storage_dropdown@settings_common.ore_option_dropdown": {
                      "ignored": "($is_holographic and $is_reality_mode)",
                      "visible": "(not $gear_vr)",
                      "enabled": "$storage_location_switch_enabled",
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "$option_dropdown_size": [ "100%", 24 ],
                      "$option_dropdown_radio_size": [ "100%", 20 ],
                      "$option_label": "options.filelocation.title",
                      "$dropdown_content": "storage_management.file_storage_location_ore_dropdown_content",
                      "$dropdown_area": "content_area",
                      "$dropdown_name": "file_storage_location",
                      "$option_enabled_binding_name": "#file_storage_location_enabled",
                      "$options_dropdown_toggle_label_binding": "#file_storage_location_toggle_label",
                      "$dropdown_scroll_content_size": [ "100%", "200%" ]
                    }
                  }
                ]
              }
            },
            { "storage_management_function_padding@common.empty_panel": { "size": [ 0, 4 ] } },
            {
              "clear_marketplace_cache_panel": {
                "type": "panel",
                "size": [ "100%", "100%c" ],
                "$focus_override_right": "FOCUS_OVERRIDE_STOP",
                "$focus_override_up": "FOCUS_OVERRIDE_STOP",
                "$clear_cache_button_text|default": "#none",
                "controls": [
                  {
                    "button@settings_common.facelift_action_button": {
                      "size": [ "100%", 26 ],
                      "$pressed_button_name": "button.clear_cache",
                      "$text": "$clear_cache_button_text",
                      "$icon_path": "textures/ui/icons/icon_delete",

                      "$default_button_texture": "textures/ui/facelift/facelift_button_top",
                      "$hover_button_texture": "textures/ui/facelift/facelift_button_top",
                      "$pressed_button_texture": "textures/ui/facelift/facelift_button_top",
                      "$locked_button_texture": "textures/ui/facelift/facelift_button_top"
                    }
                  }
                ]
              }
            },
            { "01_divider@facelift_setting_utils.content_divider_base": { "$divider_size": [ "75%", 1 ] } },
            {
              "clear_download_cache_button_panel": {
                "type": "panel",
                "size": [ "100%", "100%c" ],
                "$focus_override_right": "FOCUS_OVERRIDE_STOP",
                "$clear_download_button_text|default": "#none",
                "controls": [
                  {
                    "clear_download_button@settings_common.facelift_action_button": {
                      "size": [ "100%", 26 ],
                      "$pressed_button_name": "dev_clear_download_cache_button",
                      "$text": "options.dev_clearDownloadeCache",
                      "$icon_path": "textures/ui/icons/icon_delete",

                      "$default_button_texture": "textures/ui/facelift/facelift_button_full",
                      "$hover_button_texture": "textures/ui/facelift/facelift_button_full",
                      "$pressed_button_texture": "textures/ui/facelift/facelift_button_full",
                      "$locked_button_texture": "textures/ui/facelift/facelift_button_full"
                    }
                  }
                ]
              }
            },
            {
              "02_divider@facelift_setting_utils.content_divider_base": {
                "ignored": "$education_edition",
                "$divider_size": [ "75%", 1 ],
                "bindings": [
                  {
                    "binding_name": "#screenshots_gallery_enabled",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "delete_local_screenshots_panel": {
                "ignored": "$education_edition",
                "type": "panel",
                "size": [ "100%", "100%c" ],
                "$focus_override_right": "FOCUS_OVERRIDE_STOP",
                "$delete_local_screenshots_button_text|default": "#none",
                "controls": [
                  {
                    "button@settings_common.facelift_action_button": {
                      "size": [ "100%", 26 ],
                      "$pressed_button_name": "button.delete_local_screenshots",
                      "$text": "$delete_local_screenshots_button_text",
                      "$icon_path": "textures/ui/icons/icon_screenshots",

                      "$default_button_texture": "textures/ui/facelift/facelift_button_full",
                      "$hover_button_texture": "textures/ui/facelift/facelift_button_full",
                      "$pressed_button_texture": "textures/ui/facelift/facelift_button_full",
                      "$locked_button_texture": "textures/ui/facelift/facelift_button_full"
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "#screenshots_gallery_enabled",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "03_divider@facelift_setting_utils.content_divider_base": {
                "ignored": "$education_edition",
                "$divider_size": [ "75%", 1 ],
                "bindings": [
                  {
                    "binding_name": "#screenshots_showcase_enabled",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "clear_screenshots_cache_panel": {
                "ignored": "$education_edition",
                "type": "panel",
                "size": [ "100%", "100%c" ],
                "$focus_override_right": "FOCUS_OVERRIDE_STOP",
                "$clear_screenshots_cache_button_text|default": "#none",
                "controls": [
                  {
                    "button@settings_common.facelift_action_button": {
                      "size": [ "100%", 26 ],
                      "$pressed_button_name": "button.clear_cache",
                      "$text": "$clear_screenshots_cache_button_text",
                      "$icon_path": "textures/ui/icons/icon_screenshots",

                      "$default_button_texture": "textures/ui/facelift/facelift_button_bottom",
                      "$hover_button_texture": "textures/ui/facelift/facelift_button_bottom",
                      "$pressed_button_texture": "textures/ui/facelift/facelift_button_bottom",
                      "$locked_button_texture": "textures/ui/facelift/facelift_button_bottom"
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "#screenshots_showcase_enabled",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "storage_header_panel": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "controls": [
      {
        "header_panel": {
          "type": "stack_panel",
          "size": [ "100%", "100%c + 4px" ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            {
              "panel": {
                "type": "panel",
                "size": [ "100%", 32 ],
                "controls": [
                  {
                    "multiselect_button@common_toggles.dark_image_toggle": {
                      "size": [ "100%", "100%" ],
                      "offset": [ 0, 0 ],

                      "$toggle_name": "toggle.enableMultiselect",
                      "$button_content": "storage_management.generic_button",
                      "$button_texture": "textures/ui/multiselection",
                      "$focus_override_right": "FOCUS_OVERRIDE_STOP",

                      "$default_texture": "textures/ui/ore/button_borderless_dark_toggle",
                      "$hover_texture": "textures/ui/ore/button_borderless_darkpressed_toggle",
                      "$pressed_texture": "textures/ui/ore/button_borderless_darkhover_toggle",
                      "$pressed_no_hover_texture": "textures/ui/ore/button_borderless_darkpressed_toggle",
                      "$locked_texture": "textures/ui/ore/disabledButtonNoBorder_toggle",

                      "variables": [
                        {
                          "requires": "(not ($nx_os or $is_ps4))",
                          "$focus_override_up": "FOCUS_OVERRIDE_STOP"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "storage_footer_panel": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "controls": [
      {
        "visibleContent": {
          "type": "stack_panel",
          "size": [ "100%", 26 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "orientation": "horizontal",
          "controls": [
            {
              "share_button@settings_common.ore_action_button": {
                "ignored": true,
                "size": [ "fill", "100%" ],
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "$pressed_button_name": "button.shareResources",
                "$button_text": "storageManager.multiselectShare",
                "$focus_override_right": "FOCUS_OVERRIDE_STOP",
                "bindings": [
                  {
                    "binding_type": "global",
                    "binding_condition": "always",
                    "binding_name": "#share_button_enabled",
                    "binding_name_override": "#enabled"
                  }
                ]
              }
            },
            {
              "delete_button@settings_common.ore_action_button": {
                "$pressed_button_name": "button.deleteResources",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": [ "fill", "100%" ],
                "$button_text": "storageManager.multiselectDelete",
                "$focus_override_right": "FOCUS_OVERRIDE_STOP",
                "bindings": [
                  {
                    "binding_type": "global",
                    "binding_condition": "always",
                    "binding_name": "#delete_button_enabled",
                    "binding_name_override": "#enabled"
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#multiselectEnabled",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "storage_scroll_pane": {
    "type": "stack_panel",
    "size": [ "100% - 2px", "100%c" ],
    "offset": [ 2, 0 ],
    "controls": [
      {
        "category_stack_panel": {
          "type": "stack_panel",
          "orientation": "vertical",
          "bindings": [
            {
              "binding_name": "#category_panel_visible",
              "binding_name_override": "#visible"
            }
          ],

          "controls": [
            {
              "stack_panel": {
                "type": "stack_panel",
                "size": [ "100% - 2px", "100%c" ],
                "orientation": "vertical",

                "factory": {
                  "name": "category_items",
                  "control_ids": {
                    "world_panel": "@storage_management.world_controls",
                    "world_template_panel": "@storage_management.world_template_controls",
                    "resource_panel": "@storage_management.resource_controls",
                    "behavior_panel": "@storage_management.behavior_controls",
                    "skin_panel": "@storage_management.skin_controls",
                    "cache_panel": "@storage_management.cached_controls"
                  }
                },

                "collection_name": "storage_panel",
                "bindings": [
                  {
                    "binding_name": "#storage_panel_length",
                    "binding_name_override": "#collection_length",
                    "binding_condition": "visible"
                  }
                ]
              }
            },
            {
              "legacy_world_stack_panel": {
                "type": "stack_panel",
                "size": [ "100% - 2px", "100%c" ],
                "orientation": "vertical",

                "controls": [
                  {
                    "legacy_world_controls@storage_management.storage_main_item_legacy_world_toggle": {
                      "$button_texture": "textures/ui/WorldDemoScreen",
                      "$name_text": "storageManager.contentType.legacy_worlds",

                      "$item_template": "storage_management.world_sub_text",
                      "$panel_prefix": "legacy_world"
                    }
                  }
                ],

                "bindings": [
                  {
                    "binding_name": "#legacy_world_visible",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "retailtopreview_world_stack_panel": {
                "type": "stack_panel",
                "size": [ "100% - 2px", "100%c" ],
                "orientation": "vertical",

                "controls": [
                  {
                    "retailtopreview_world_controls@storage_management.storage_main_item_retailtopreview_world_toggle": {
                      "$button_texture": "textures/ui/WorldDemoScreen",
                      "$name_text": "storageManager.contentType.retailtopreview_worlds",

                      "$item_template": "storage_management.world_sub_text",
                      "$panel_prefix": "retailtopreview_world"
                    }
                  }
                ],

                "bindings": [
                  {
                    "binding_name": "#retailtopreview_world_visible",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "multiselect_padding": {
          "type": "panel",
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "size": [ "100%", 32 ],
          "bindings": [
            {
              "binding_name": "#multiselectEnabled",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "storage_main_item_toggle": {
    "type": "stack_panel",
    "size": [ "100%", "default" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "orientation": "vertical",
    "controls": [
      {
        "main_item_toggle@common_toggles.light_ui_toggle": {
          "$size_text": "('#' + $panel_prefix + _size)",

          "size": [ "100%", 30 ],
          "$button_content_size": [ "100% - 6px", "100%" ],
          "$button_type_panel": "storage_management.main_item_text",

          "$toggle_name": "('#' + $panel_prefix + _tab)",
          "$toggle_state_binding_name": "#storage_dropdown",
          "$toggle_binding_type": "collection",
          "$toggle_grid_collection_name": "storage_panel",
          "$toggle_group_default_selected": 1,
          "$toggle_tts_name": "accessibility.dropdown.tts.title",

          "$focus_override_right": "FOCUS_OVERRIDE_STOP"
        }
      },
      {
        "contentPanel": {
          "type": "stack_panel",
          "orientation": "vertical",
          "visible": false,
          "size": [ "100%", "default" ],
          "$item_template|default": "storage_management.texture_icon_text",
          "$panel_length": "('#' + $panel_prefix + _length)",

          "factory": {
            "name": "resource_item",
            "control_name": "storage_management.resource_sub_item"
          },

          "collection_name": "($panel_prefix + _panel)",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "this_toggle",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible",
              "resolve_sibling_scope": true
            },
            {
              "binding_name": "$panel_length",
              "binding_name_override": "#collection_length",
              "binding_condition": "visible"
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": [ "100%", 2 ]
        }
      }
    ]
  },


  // Design
  "resource_controls@storage_management.storage_main_item_toggle": {
    "$button_texture": "textures/ui/op",
    "$name_text": "storageManager.contentType.resourcePacks",

    "$item_template": "storage_management.new_pack_description_sub_item",
    "$panel_prefix": "resource"
  },

  "behavior_controls@storage_management.storage_main_item_toggle": {
    "$button_texture": "textures/ui/anvil_icon",
    "$name_text": "storageManager.contentType.behaviorPacks",

    "$item_template": "storage_management.new_pack_description_sub_item",
    "$panel_prefix": "behavior"
  },

  "new_texture_icon_text@storage_management.icon_item_text": {
    "size": [ "100%", 34 ],
    "$image_size": [ "100%y + 2px", "100%" ],
    "$button_texture": "('#' + $panel_prefix + _texture)",
    "$button_texture_zip": "('#' + $panel_prefix + _texture_zip)",
    "$button_texture_file": "('#' + $panel_prefix + _texture_file_system)",
    "$texture_binding_type": "collection",
    "$texture_binding_collection": "($panel_prefix + _panel)"
  },

  "new_pack_description_sub_item@storage_management.new_texture_icon_text": {
    "$check_visible": true,
    "$text_controls": [
      {
        "panel": {
          "type": "stack_panel",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "controls": [
            {
              "main_label@storage_management.common_label": {
                "size": [ "65%", 8 ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [ 0, 9 ],

                "text": "$name_text",
                "color": "$body_text_color",
                "bindings": "$name_bindings"
              }
            },
            { "void_panel@common.empty_panel": { "size": [ 0, 2 ] } },
            {
              "glyphs_and_version": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "size": [ "100% - 4px", 9 ],
                "layer": 4,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "controls": [
                  {
                    "glyph_warning@storage_management.base_glyph": {
                      "$binding_name": "warning",
                      "$glyph_texture": "textures/ui/WarningGlyph"
                    }
                  },
                  {
                    "glyph_error@storage_management.base_glyph": {
                      "$binding_name": "error",
                      "$glyph_texture": "textures/ui/ErrorGlyph"
                    }
                  },
                  {
                    "glyph_update@storage_management.base_glyph": {
                      "$binding_name": "update",
                      "$glyph_texture": "textures/ui/UpdateGlyph"
                    }
                  },
                  {
                    "version_label@storage_management.common_label": {
                      "size": [ "fill", "100%" ],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",

                      "$version_name": "('#sub_' + $panel_prefix + _version)",
                      "$version_binding_visible": "('#sub_' + $panel_prefix + _valid)",
                      "$version_binding_collection": "($panel_prefix + _panel)",

                      "text": "$version_name",
                      "color": "$light_button_secondary_default_text_color",
                      "bindings": [
                        {
                          "binding_type": "collection",
                          "binding_collection_name": "$version_binding_collection",
                          "binding_name": "$version_name"
                        },
                        {
                          "binding_type": "collection",
                          "binding_collection_name": "$version_binding_collection",
                          "binding_name": "$version_binding_visible",
                          "binding_name_override": "#visible"
                        },
                        {
                          "binding_type": "collection_details"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "size_label@storage_management.common_label": {
          "size": "$right_label_size",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [ -5, 0 ],

          "text": "$size_text",
          "color": "$light_button_secondary_default_text_color",
          "bindings": "$size_bindings"
        }
      }
    ]
  },


  // Dropdown Content
  "file_storage_location_ore_dropdown_content@settings_common.option_radio_dropdown_group": {
    "$radio_buttons": [
      {
        "file_storage_location_option_external@settings_common.ore_radio_with_label": {
          "$toggle_state_binding_name": "#storage_location_radio_external",
          "$radio_label_text": "options.filelocation.external"
        }
      },
      {
        "file_storage_location_option_appdata@settings_common.ore_radio_with_label": {
          "$toggle_state_binding_name": "#storage_location_radio_package",
          "$radio_label_text": "options.filelocation.appdata"
        }
      }
    ]
  },

  "auto_update_mode_facelift_dropdown_content@settings_common.facelift_option_radio_dropdown_group": {
    "$radio_buttons": [
      {
        "off@settings_common.facelift_radio_with_label": {
          "$default_texture": "textures/ui/facelift/facelift_button_top_right",
          "$hover_texture": "textures/ui/facelift/facelift_button_top_right",
          "$pressed_texture": "textures/ui/facelift/facelift_button_top_right",
          "$pressed_no_hover_texture": "textures/ui/facelift/facelift_button_top_right",
          "$locked_texture": "textures/ui/facelift/facelift_button_top_right",

          "$toggle_state_binding_name": "#auto_update_mode_off",
          "$radio_label_text": "options.autoUpdateMode.off"
        }
      },
      { "wifi_divider@facelift_setting_utils.content_divider_base": { "$divider_size": [ "75%", 1 ] } },
      {
        "wifi@settings_common.facelift_radio_with_label": {
          "$default_texture": "textures/ui/facelift/facelift_button_full",
          "$hover_texture": "textures/ui/facelift/facelift_button_full",
          "$pressed_texture": "textures/ui/facelift/facelift_button_full",
          "$pressed_no_hover_texture": "textures/ui/facelift/facelift_button_full",
          "$locked_texture": "textures/ui/facelift/facelift_button_full",

          "$toggle_state_binding_name": "#auto_update_mode_on_wifi_only",
          "$radio_label_text": "options.autoUpdateMode.on.withWifiOnly"
        }
      },
      { "cellular_divider@facelift_setting_utils.content_divider_base": { "$divider_size": [ "75%", 1 ] } },
      {
        "cellular@settings_common.facelift_radio_with_label": {
          "$default_texture": "textures/ui/facelift/facelift_button_bottom",
