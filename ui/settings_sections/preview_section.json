{
  "namespace": "preview_section",

  // Ore Icon Button
  "show_setting_selector_toggle@common_toggles.light_text_toggle": {
    "size": [ "100%", "100%" ],
    "$button_type_panel": "preview_section.show_setting_selector_toggle_content_panel",
    "$toggle_name": "show_setting_selector",
    "$toggle_view_binding_name": "setting_selector_visible",

    "$button_image_size": [ "100%", "100%" ],

    "$default_border_visible": false,
    "$hover_border_visible": false,

    "$default_texture": "$facelift_texture",
    "$hover_texture": "$facelift_texture",
    "$pressed_texture": "$facelift_texture",
    "$pressed_no_hover_texture": "$facelift_texture",
    "$locked_texture": "$facelift_texture",

    "$default_texture_alpha": "$facelift_texture_alpha",
    "$default_checked_texture_alpha": "$facelift_texture_alpha",
    "$hover_texture_alpha": "$facelift_texture_alpha",
    "$hover_checked_texture_alpha": "$facelift_texture_alpha",

    "$default_texture_color": "$facelift_texture_default_color",
    "$default_checked_texture_color": "$facelift_texture_default_checked_color",
    "$hover_texture_color": "$facelift_texture_hover_color",
    "$hover_checked_texture_color": "$facelift_texture_hover_checked_color"
  },

  "show_setting_selector_toggle_content_panel": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "$toggle_icon|default": "textures/ui/icons/icon_setting_selector_hide",
    "variables": [
      {
        "requires": "($toggle_checked or $toggle_checked_hover)",
        "$toggle_icon": "textures/ui/icons/icon_setting_selector_show"
      }
    ],
    "controls": [
      {
        "icon": {
          "type": "image",
          "size": [ "95%", "95%" ],
          "offset": [ 0.25, 0.25 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "texture": "$toggle_icon"
        }
      }
    ]
  },

  "account_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "account_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_account",
    "$button_text": "options.account",
    "$toggle_property_bag": {
      "#panel_title": "options.accountTitle"
    }
  },

  "quick_setting_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "quick_setting_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_quick_settings",
    "$button_text": "quick_section.quick_setting",
    "$toggle_property_bag": {
      "#panel_title": "$button_text"
    }
  },

  "accessibility_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$facelift_button_type_left": true,
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "accessibility_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_accessibility",
    "$button_text": "options.accessibility",
    "$toggle_property_bag": {
      "#panel_title": "options.accessibility.title"
    }
  },

  "graphics_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$facelift_button_type_full_horizontal": true,
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "graphics_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_graphics",
    "$button_text": "graphics_section.graphics",
    "$toggle_property_bag": {
      "#panel_title": "graphics_section.graphicsTitle"
    }
  },

  "etc_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$facelift_button_type_full_horizontal": true,
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "etc_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_general",
    "$button_text": "general_section.etc",
    "$toggle_property_bag": {
      "#panel_title": "general_section.etcTitle"
    }
  },

  "controls_ore_icon_button@settings_common.facelift_section_toggle_full_horizontal_base": {
    "size": [ 30, 30 ],
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "controls_button_toggle",
    "$glyph_color_texture": "textures/ui/empty",
    "variables": [
      {
        "requires": "($touch)",
        "$glyph_color_texture": "textures/ui/ore/icons/icon_touch"
      },
      {
        "requires": "($mouse)",
        "$glyph_color_texture": "textures/ui/ore/icons/icon_keyborad_and_mouse"
      },
      {
        "requires": "($game_pad)",
        "$glyph_color_texture": "textures/ui/ore/icons/icon_gamepad"
      }
    ],
    "$button_text": "controls_section.controls",
    "$toggle_property_bag": {
      "#panel_title": "$button_text"
    }
  },

  "global_texture_pack_ore_icon_button@resource_packs.ore_icon_resource_packs_section_toggle_base": {
    "size": [ 30, 30 ],
    "$toggle_view_binding_name": "global_texture_pack_button_toggle",
    "$cycling_icon_path": "#cycling_icon_path_global",
    "$cycling_icon_zip": "#cycling_icon_zip_global",
    "$cycling_icon_file_system": "#cycling_icon_file_system_global",
    "$button_text": "menu.globalpacks",
    "$toggle_property_bag": {
      "#panel_title": "menu.globalpacks"
    }
  },

  "storage_management_ore_icon_button@settings_common.facelift_section_toggle_full_horizontal_base": {
    "size": [ 30, 30 ],
    "enabled": "(not $trial)",
    "visible": "($is_pregame)",
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "storage_management_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_storage",
    "variables": [
      {
        "requires": "$education_edition",
        "$button_text": "menu.eduLocalStorage",
        "$toggle_property_bag": {
          "#panel_title": "menu.eduLocalStorage"
        }
      },
      {
        "requires": "(not $education_edition)",
        "$button_text": "menu.storageManagement",
        "$toggle_property_bag": {
          "#panel_title": "menu.storageManagement"
        }
      }
    ]
  },

  "creator_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$facelift_button_type_full_horizontal": true,
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "ignored": "$ignore_creator_section",
    "$toggle_view_binding_name": "creator_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_creator",
    "$button_text": "options.creator",
    "$toggle_property_bag": {
      "#panel_title": "options.creatorTitle"
    }
  },

  "view_subscriptions_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$facelift_button_type_full_horizontal": true,
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "enabled": "(not $trial)",
    "$toggle_view_binding_name": "view_subscriptions_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_subscriptions",
    "$button_text": "options.viewSubscriptions",
    "$toggle_property_bag": {
      "#panel_title": "options.viewSubscriptions"
    }
  },

  "sound_language_category_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$facelift_button_type_full_horizontal": true,
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "sound_language_category_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_sound_language",
    "$button_text": "options.category.sound_language",
    "$toggle_property_bag": {
      "#panel_title": "$button_text"
    }
  },

  "how_to_play_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$facelift_button_type_right": true,
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "how_to_play_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_how_to_play",
    "$button_text": "menu.howToPlay",
    "$toggle_property_bag": {
      "#panel_title": "menu.howToPlay"
    }
  },

  "preview_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "ignored": "(not $show_preview_button)",
    "$toggle_view_binding_name": "preview_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_debug",
    "$button_text": "offer.preview",
    "$toggle_property_bag": {
      "#panel_title": "$button_text"
    }
  },

  "world_category_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "world_category_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_world_tab_alt_02",
    "$button_text": "options.category.world",
    "$toggle_property_bag": {
      "#panel_title": "createWorldScreen.worldSettings"
    }
  },

  "debug_category_ore_icon_button@settings_common.facelift_section_toggle_base": {
    "size": [ 30, 30 ],
    "$button_type_panel": "button_content_preset.facelift_icon_button_content",
    "$toggle_view_binding_name": "debug_category_button_toggle",
    "$glyph_color_texture": "textures/ui/ore/icons/icon_debug",
    "$button_text": "options.category.debug",
    "$toggle_property_bag": {
      "#panel_title": "$button_text"
    }
  }
}