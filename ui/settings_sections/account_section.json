{
  "namespace": "account_section",

  // Account button & section
  "account_ore_button@settings_common.ore_section_toggle_base": {
    "$toggle_view_binding_name": "account_button_toggle",
    "$glyph_texture": "textures/ui/ore/icon_border",
    "$glyph_color_texture": "textures/ui/ore/icon_account",
    "$glyph_size": [ 17, 17 ],
    "$button_text": "options.account",
    "$toggle_property_bag": {
      "#panel_title": "options.accountTitle"
    }
  },

  "account_transparent_button@settings_common.section_toggle_base": {
    "$button_type_panel": "common.empty_panel",
    "$toggle_view_binding_name": "top_account_button_toggle",
    "$toggle_property_bag": {
      "#panel_title": "options.accountTitle"
    },

    "$default_border_visible": false,
    "$hover_border_visible": false,

    "$default_texture": "textures/ui/facelift/facelift_button",
    "$hover_texture": "textures/ui/facelift/facelift_button",
    "$pressed_texture": "textures/ui/facelift/facelift_button",
    "$pressed_no_hover_texture": "textures/ui/facelift/facelift_button",
    "$locked_texture": "textures/ui/facelift/facelift_button",

    "$default_texture_alpha": 0.6,
    "$default_checked_texture_alpha": 0.6,
    "$hover_texture_alpha": 0.6,
    "$hover_checked_texture_alpha": 0.6,

    "$default_texture_color": [ 0.0, 0.0, 0.0 ],
    "$default_checked_texture_color": [ 0.0, 0.0, 0.0 ],
    "$hover_texture_color": [ 0.4, 0.4, 0.4 ],
    "$hover_checked_texture_color": [ 0.4, 0.4, 0.4 ]
  },

  "account_setting_section@facelift_setting_utils.facelift_content_panel_base": {
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "top_account_button_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#top_visible"
      },
      {
        "binding_type": "view",
        "source_control_name": "account_button_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#ori_visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#top_visible or #ori_visible)",
        "target_property_name": "#visible"
      }
    ],
    "$compact_mode": true,
    "$show_content_background": false,
    "$section_content": "account_section.account_section",
    "$section_footer_content": "account_section.account_footer_sction"
  },

  "account_section": {
    "type": "stack_panel",
    "size": [ "100%", "100%cm" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "orientation": "horizontal",
    "$spatialPatternsPadding": [ "100%", 8 ],
    "$paddingLineDivider": [ "100%", 16 ],
    "$hide_login_button": "($win10_edition or not $is_xboxlive_enabled)",
    "controls": [
      {
        "left_stack_panel@common.vertical_stack_panel": {
          "size": [ "fill", "100%c" ],
          "controls": [
            {
              "player_info_with_function_panel@facelift_setting_utils.settings_content_background_base": {
                "$content_controls": [
                  {
                    "player_gamertag@account_section.player_info_with_function_panel": {}
                  }
                ]
              }
            },
            { "00_padding@common.empty_panel": { "size": [ 0, 4 ] } },
            {
              "deviceId_info_panel@facelift_setting_utils.settings_content_background_base": {
                "$content_controls": [
                  {
                    "deviceId_info@account_section.deviceId_info_panel": {}
                  }
                ]
              }
            },
            { "01_padding@common.empty_panel": { "size": [ 0, 4 ] } },
            {
              "minecraftAccountId_info_panel@facelift_setting_utils.settings_content_background_base": {
                "$content_controls": [
                  {
                    "minecraftAccountId_info@account_section.minecraftAccountId_info_panel": {}
                  }
                ]
              }
            },
            { "02_padding@common.empty_panel": { "size": [ 0, 4 ] } },
            {
              "use_remote_connect_toggle@settings_common.facelift_option_toggle": {
                "enabled": "(($google_os or $is_ios) and (not $education_edition))",
                "$option_label": "options.useRemoteConnect",
                "$option_binding_name": "#use_remote_connect",
                "$option_enabled_binding_name": "#use_remote_connect_enabled",
                "$toggle_name": "use_remote_connect",

                "$icon_path": "textures/ui/accessibility_glyph"
              }
            }
          ]
        }
      },
      { "void_panel@common.empty_panel": { "size": [ 4, 0 ] } },
      {
        "right_stack_panel@common.vertical_stack_panel": {
          "size": [ "fill", "100%c" ],
          "controls": [
            {
              "editon_and_os_panel@facelift_setting_utils.settings_content_background_base": {
                "$content_controls": [
                  {
                    "editon_and_os_stack_panel@account_section.edition_and_os_info_panel": {
                      "size": [ "100%", "30%x" ]
                    }
                  }
                ]
              }
            },
            {
              "00_padding@common.empty_panel": {
                "ignored": "($device_must_be_removed_for_xbl_signin or not $is_pregame or $disable_gamertag_controls)",
                "size": [ 0, 4 ],
                "bindings": [
                  {
                    "binding_name": "#logged_in",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "manage_account@account_section.manage_account_button_panel": {
                "ignored": "($device_must_be_removed_for_xbl_signin or not $is_pregame or $disable_gamertag_controls)",
                "bindings": [
                  {
                    "binding_name": "#logged_in",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "01_padding@common.empty_panel": {
                "ignored": "(not $is_realms_enabled or not $is_pregame or $pre_release)",
                "size": [ 0, 4 ],
                "bindings": [
                  {
                    "binding_name": "#logged_in",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "realms_invites": {
                "ignored": "(not $is_realms_enabled or not $is_pregame or $pre_release)",
                "type": "panel",
                "size": [ "100%", 24 ],
                "controls": [
                  {
                    "check_realms_invites_button@settings_common.facelift_action_button": {
                      "size": [ "100%", "100%" ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "offset": [ 0, 0 ],
                      "$pressed_button_name": "realms_invites_button",
                      "$button_text": "options.realms.checkInvites",

                      "$icon_path": "textures/ui/icons/icon_envelope"
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "#logged_in",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            { "02_padding@common.empty_panel": { "ignored": "$ignore_profile_switch_account_button", "size": [ 0, 4 ] } },
            {
              "switch_accounts_panel@facelift_setting_utils.settings_content_background_base": {
                "ignored": "$ignore_profile_switch_account_button",
                "$content_controls": [
                  {
                    "switch_accounts@account_section.switch_accounts_panel": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "account_footer_sction": {
    "$spatialPatternsPadding": [ "100%", 8 ],
    "$paddingLineDivider": [ "100%", 16 ],
    "$hide_login_button": "($win10_edition or not $is_xboxlive_enabled)",

    "type": "panel",
    "size": [ "100%", "100%c" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#logged_in",
        "binding_name_override": "#visible"
      }
    ],
    "controls": [
      {
        "buttons_panel": {
          "type": "stack_panel",
          "size": [ "65%", "100%cm" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "orientation": "horizontal",
          "controls": [
            {
              "sign_out@settings_common.facelift_action_button": {
                "ignored": "($ms_platform or not $is_pregame or $requires_xbl_signin_to_play)",
                "size": [ "fill", 24 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "$button_type_panel": "button_content_preset.text_content_panel",
                "$pressed_button_name": "sign_out_button",
                "$button_text": "xbox.signOutLong"
              }
            },
            {
              "paddingDeleteAccount@common.empty_panel": {
                "ignored": "((not $is_pregame) or (not $is_ios))",
                "size": [ 4, 0 ]
              }
            },
            {
              "delete_account@settings_common.facelift_action_button": {
                "ignored": "((not $is_pregame) or (not $is_ios))",
                "size": [ "fill", 24 ],
                "$button_type_panel": "button_content_preset.text_content_panel",
                "$pressed_button_name": "button.delete_account",
                "$button_text": "options.delete_account.button"
              }
            }
          ]
        }
      },
      {
        "padding_panel": {
          "type": "panel",
          "size": [ 0, "100%cm" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "paddingSignOut@common.empty_panel": {
                "ignored": "($ms_platform or not $is_pregame or $requires_xbl_signin_to_play)",
                "size": [ 0, 4 ]
              }
            },
            {
              "paddingDeleteAccount@common.empty_panel": {
                "ignored": "((not $is_pregame) or (not $is_ios))",
                "size": [ 0, 4 ]
              }
            }
          ]
        }
      }
    ]
  },


  "edition_and_os_info_panel": {
    "type": "stack_panel",
    "size": [ "100%", "100%" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "orientation": "horizontal",
    "controls": [
      {
        "edition_panel": {
          "type": "panel",
          "size": [ "fill", "100%" ],
          "controls": [
            {
              "edition_content@account_section.edition_and_os_info_base": {
                "variables": [
                  {
                    "requires": "$win10_edition",
                    "$info_icon": "textures/ui/icons/icon_desktop",
                    "$info_text": "Windows Edition"
                  },
                  {
                    "requires": "$pocket_edition",
                    "$info_icon": "textures/ui/icons/icon_pocket",
                    "$info_text": "Pocket Edition"
                  },
                  {
                    "requires": "$console_edition",
                    "$info_icon": "textures/ui/icons/icon_console",
                    "$info_text": "Console Edition"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "light_line@settings_common.light_line_vertical_panel": {
          "$panel_size": [ "100%c + 4px", "100%" ],
          "$line_size": [ 1, "75%" ]
        }
      },
      {
        "os_panel": {
          "type": "panel",
          "size": [ "fill", "100%" ],
          "controls": [
            {
              "os_content@account_section.edition_and_os_info_base": {
                "variables": [
                  {
                    "requires": "$microsoft_os",
                    "$info_icon": "textures/ui/icons/icon_windows",
                    "$info_text": "Windows 10/11"
                  },
                  {
                    "requires": "$apple_os",
                    "$info_icon": "textures/ui/icons/icon_ios",
                    "$info_text": "iOS/iPadOS"
                  },
                  {
                    "requires": "$google_os",
                    "$info_icon": "textures/ui/icons/icon_android",
                    "$info_text": "Android"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "edition_and_os_info_base": {
    "type": "stack_panel",
    "size": [ "100%y", "95%" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "$info_icon|default": "textures/ui/icon_none",
    "$info_text|default": "None",
    "controls": [
      {
        "icon_panel": {
          "type": "panel",
          "size": [ "100%", "fill" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "icon_cover": {
                "type": "panel",
                "size": [ "100%", "80%" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "icon": {
                      "type": "image",
                      "size": [ "100%y", "100%" ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "texture": "$info_icon"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "label_panel": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "label": {
                "type": "label",
                "size": [ "100%", "default" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "text": "$info_text",
                "text_alignment": "center"
              }
            }
          ]
        }
      }
    ]
  },


  "account_function_toggles_panel": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "paddingPause": {
          "type": "panel",
          "size": "$spatialPatternsPadding",
          "bindings": [
            {
              "binding_name": "#pause_toggle_enabled",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "passcodeRequired_autoAttach_options@settings_common.new_options_design_base": {
          "$options_1": [
            {
              "only_allow_trusted_skins_toggle@settings_common.ore_option_toggle": {
                "$option_label": "options.onlyTrustedSkinsAllowed",
                "$option_binding_name": "#only_trusted_skins_allowed",
                "$option_enabled_binding_name": "#only_trusted_skins_allowed_enabled",
                "$toggle_name": "only_trusted_skins_allowed"
              }
            }
          ],
          "$options_2": [
            {
              "pause_toggle@settings_common.ore_option_toggle": {
                "$option_label": "options.pauseHint",
                "$option_binding_name": "#pause_option_toggle",
                "$toggle_name": "pause_option_toggle",
                "bindings": [
                  {
                    "binding_name": "#pause_toggle_enabled",
                    "binding_name_override": "#enabled"
                  }
                ]
              }
            }
          ]
        }
      },

      {
        "paddingUseRemoteConnect": {
          "ignored": "(((not $google_os) and (not $is_ios)) or ($education_edition))",
          "type": "panel",
          "size": "$spatialPatternsPadding"
        }
      },
      {
        "remote_connect_toggle@settings_common.facelift_option_toggle": {
          "ignored": "(((not $google_os) and (not $is_ios)) or ($education_edition))",
          "$option_label": "options.useRemoteConnect",
          "$option_binding_name": "#use_remote_connect",
          "$option_enabled_binding_name": "#use_remote_connect_enabled",
          "$toggle_name": "use_remote_connect"
        }
      }
    ]
  },


  "device_with_minecraftAccount_id_panel": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "device_id_label": {
          "type": "label",
          "size": [ "100%", "default" ],
          "offset": [ 2, 0 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "text": "#device_id",
          "color": "$body_text_color",
          "bindings": [
            {
              "binding_name": "#device_id"
            }
          ]
        }
      },
      {
        "MinecraftAccount_id_label": {
          "type": "label",
          "size": [ "100%", "default" ],
          "offset": [ 2, 0 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "text": "#MinecraftAccount_id",
          "color": "$body_text_color",
          "bindings": [
            {
              "binding_name": "#MinecraftAccount_id"
            }
          ]
        }
      }
    ]
  },


  "manage_account_button_panel": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "$spatialPatternsPadding": [ "100%", 8 ],
    "$paddingLineDivider": [ "100%", 16 ],
    "$hide_login_button": "($win10_edition or not $is_xboxlive_enabled)",
    "controls": [
      {
        "manage_account_panel": {
          "type": "panel",
          "size": [ "100%", 24 ],
          "controls": [
            {
              "manage_account_button@settings_common.facelift_action_button": {
                "ignored": "($is_ios or $is_android)",
                "size": [ "100%", 24 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "$pressed_button_name": "manage_account_button",
                "$button_text": "options.manageAccount",

                "$icon_path": "textures/ui/icons/icon_user_online"
              }
            },
            {
              "manage_account_button_mobile@settings_common.facelift_link_button": {
                "ignored": "(not ($is_ios or $is_android))",
                "size": [ "100%", 24 ],
                "anchor_from": "center",
                "anchor_to": "center",

                "$button_type_panel": "button_content_preset.image_with_text_content_panel",
                "$button_text": "options.manageAccount",
                "property_bag": {
                  "#hyperlink": "https://account.xbox.com/Settings"
                },

                "$icon_path": "textures/ui/icons/icon_user_online"
              }
            }
          ]
        }
      }
    ]
  },


