{
  "namespace": "progress",

  "progress_screen@common.base_screen": {
    "force_render_below": "$force_render_below",
    "$screen_animations": [
      "@common.screen_exit_animation_push_fade",
      "@common.screen_exit_animation_pop_fade"
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },

  "popup_dialog_factory": {
    "type": "factory",
    "control_ids": {
      "test": "dialog@progress.popup_dialog_base",
      "resource_pack_download_server_required": "resource_pack_download_server_required@progress.resource_pack_download_server_required",
      "resource_pack_download_optional_and_required": "resource_pack_download_optional_and_required@progress.resource_pack_download_optional_and_required",
      "resource_pack_download_optional": "resource_pack_download_optional@progress.resource_pack_download_optional",
      "resource_pack_download_required": "resource_pack_download_required@progress.resource_pack_download_required"
    }
  },


  "world_loading_progress_screen@progress_screen": {
    "$screen_content": "progress.world_convert_modal_progress_screen_content"
  },

  "world_convert_modal_progress_screen@progress.progress_screen": {
    "$screen_content": "progress.world_convert_modal_progress_screen_content"
  },

  "world_convert_modal_progress_screen_content": {
    "layer": 3,
    "type": "panel",
    "controls": [
      { "mobile_data_icon@progress.mobile_data_icon": {} },
      {
        "progress_content_panel": {
          "type": "panel",
          "size": [ "100%", "100%" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "progress_content@progress.progress_design_base": {
                "$panel_type": "progress.modal_button_panel"
              }
            }
          ]
        }
      },
      { "popup_dialog_factory@progress.popup_dialog_factory": {} }
    ]
  },

  "realms_loading_world_modal_progress_screen_content": {
    "type": "panel",
    "controls": [
      { "mobile_data_icon@progress.mobile_data_icon": {} },
      {
        "progress_content_panel": {
          "type": "panel",
          "size": [ "100%", "100%" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "world_modal_progress_panel@progress.progress_design_base": {
                "$logo_title_size": [ 330, "20%x" ],
                "$logo_title_texutre": "textures/ui/realms_title",
                "$panel_type": "progress.modal_button_panel"
              }
            }
          ]
        }
      },
      { "popup_dialog_factory@progress.popup_dialog_factory": {} },
      {
        "server_region_connected": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "offset": [ 0, 30 ],
          "size": [ "100%c", "100%c" ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "controls": [
            {
              "server_region_label": {
                "type": "label",
                "text": "progressScreen.label.serverRegion",
                "color": "$loading_text_color",
                "size": [ "default", 35 ]
              }
            },
            {
              "server_region_connected_text": {
                "type": "label",
                "text": "#server_region_text",
                "color": "$loading_text_color",
                "size": [ "default", 35 ],
                "bindings": [
                  {
                    "binding_name": "#server_region_text"
                  }
                ]
              }
            },
            {
              "padding": {
                "type": "panel",
                "size": [ 8, 0 ]
              }
            },
            {
              "server_region_ping_icon": {
                "type": "image",
                "texture": "#server_region_ping_icon",
                "size": [ 8, 8 ],
                "bindings": [
                  {
                    "binding_name": "#server_region_ping_icon",
                    "binding_name_override": "#texture"
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#server_region_connected_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "world_save_modal_progress_screen_content": {
    "type": "panel",
    "controls": [
      {
        "progress_content_panel": {
          "type": "panel",
          "size": [ "100%", "100%" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "progress_content@progress.progress_design_base": {
                "$panel_type": "progress.modal_button_panel_with_retry",
                "$unused_auto_save_animation": false
              }
            }
          ]
        }
      },
      { "popup_dialog_factory@progress.popup_dialog_factory": {} }
    ]
  },

  "progress_design_base": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "$logo_title_size|default": [ "85%", "10%x" ],
    "$logo_title_texutre|default": "textures/ui/title",
    "$panel_type|default": "common.empty_panel",
    "$unused_auto_save_animation|default": true,
    "controls": [
      {
        "progress_image_panel": {
          "type": "panel",
          "size": [ "100%", "100%cm" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "progress_image": {
                "layer": 3,
                "type": "image",
                "size": [ "55% - 24px", "100%c + 24px" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "texture": "$facelift_texture",
                "color": "$facelift_texture_default_color",
                "alpha": "$facelift_texture_alpha",
                "controls": [
                  {
                    "content": {
                      "type": "stack_panel",
                      "size": [ "100% - 8px", "100%c + 8px" ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "controls": [
                        {
                          "title_panel": {
                            "layer": 5,
                            "type": "panel",
                            "size": [ "100%", "100%c + 8px" ],
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "controls": [
                              {
                                "logo_title": {
                                  "layer": 5,
                                  "type": "image",
                                  "size": "$logo_title_size",
                                  "anchor_from": "center",
                                  "anchor_to": "center",
                                  "texture": "$logo_title_texutre"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "progress_loading_bars_content": {
                            "type": "stack_panel",
                            "size": [ "100%", "100%c" ],
                            "bindings": [
                              {
                                "binding_name": "#bar_animation_visible",
                                "binding_name_override": "#visible"
                              }
                            ],
                            "controls": [
                              { "void_panel@common.empty_panel": { "size": [ 0, 4 ] } },
                              {
                                "content": {
                                  "type": "panel",
                                  "size": [ "100%", "100%c + 8px" ],
                                  "controls": [
                                    { "loading_bars@progress.new_progress_loading_bars": {} }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "progress_auto_save_content": {
                            "ignored": "$unused_auto_save_animation",
                            "type": "stack_panel",
                            "size": [ "100%", "100%c" ],
                            "bindings": [
                              {
                                "binding_name": "#auto_save_animation_visible",
                                "binding_name_override": "#visible"
                              }
                            ],
                            "controls": [
                              { "void_panel@common.empty_panel": { "size": [ 0, 4 ] } },
                              {
                                "content": {
                                  "type": "panel",
                                  "size": [ "100%", "100%c + 8px" ],
                                  "controls": [
                                    { "auto_save@progress.new_auto_save": {} }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        { "progress_content_void_panel@common.empty_panel": { "size": [ 0, 6 ] } },
                        {
                          "world_modal_progress_panel@progress.world_modal_progress_panel": {
                            "$modal_button_panel_type": "$panel_type"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "void_panel@common.empty_panel": {
          "size": [ 0, 4 ],
          "bindings": [
            {
              "binding_name": "#cancel_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "close_button_panel": {
          "type": "panel",
          "size": [ "100%", "100%c + 4px" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            { "cancel_button@progress.new_cancel_button": { } }
          ],
          "bindings": [
            {
              "binding_name": "#cancel_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },


  // Progress Animation Icons
  "new_auto_save": {
    "layer": 31,
    "type": "image",
    "size": [ 18, 30 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ 18, 30 ],
    "uv_size": [ 18, 30 ],
    "uv": "@auto_save_animation",
    "texture": "textures/ui/auto_save",
    "disable_anim_fast_forward": true,
    "bindings": [
      {
        "binding_name": "#auto_save_animation_visible",
        "binding_name_override": "#visible"
      }
    ]
  },

  "new_progress_loading_bars": {
    "layer": 2,
    "type": "image",
    "size": [ 64, 8 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "uv_size": [ 64, 8 ],
    "uv": "@progress.bar_animation",
    "texture": "textures/ui/loading_bar",
    "color": [ 0.7, 0.7, 0.7, 1.0 ],
    "bindings": [
      {
        "binding_name": "#bar_animation_visible",
        "binding_name_override": "#visible"
      }
    ]
  },


  // Progress Content
  "empty_progress_bar_icon": {
    "type": "image",
    "texture": "textures/ui/experiencebarempty"
  },

  "full_progress_bar_icon_base": {
    "type": "image",
    "texture": "textures/ui/filled_progress_bar",
    "clip_direction": "left",
    "clip_pixelperfect": false
  },

  "progress_bar_nub": {
    "type": "image",
    "texture": "textures/ui/experience_bar_nub_blue",
    "tiled": true
  },

  "thick_progress_bar_icon_base": {
    "type": "image",
    "texture": "textures/ui/progress_bar_simple",
    "color": "$day_one_experience_import_progress_bar_fill",
    "clip_direction": "left",
    "clip_pixelperfect": false
  },

  "thick_progress_bar_icon_empty": {
    "type": "image",
    "texture": "textures/ui/progress_bar_simple",
    "color": "$day_one_experience_import_progress_bar_empty"
  },

  "fancy_progress_loading_bars": {
    "layer": 5,
    "type": "panel",
    "size": [ "95%", 5 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "full_progress_bar_icon@progress.full_progress_bar_icon_base": {
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#loading_bar_percentage",
              "binding_name_override": "#clip_ratio"
            }
          ]
        }
      },
      {
        "empty_progress_bar_icon@progress.empty_progress_bar_icon": { "layer": 1 }
      },
      {
        "progress_bar_nub@progress.progress_bar_nub": { "layer": 4, "size": [ "100% - 10px", 5 ] }
      }
    ],
    "bindings": [
      {
        "binding_name": "#loading_bar_visible",
        "binding_name_override": "#visible"
      }
    ]
  },

  "progress_title_world_panel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c + 6px" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "progress_title_text@progress.progress_title_text": {
          "size": [ "100%", "default" ],
          "max_size": [ "100%", "default" ],
          "text": "#title_text",
          "text_alignment": "center",
          "font_scale_factor": 1.4,
          "shadow": true,
          "color": [ 1.0, 1.0, 1.0 ],
          "bindings": [
            { "binding_name": "#title_text" }
          ]
        }
      },
      { "void_panel@common.empty_panel": { "size": [ 0, 2 ] } },
      {
        "progress_bar_text@progress.progress_bar_text": {
          "size": [ "100%", "default" ],
          "max_size": [ "100%", "default" ],
          "text": "#progress_text",
          "text_alignment": "center",
          "shadow": true,
          "color": [ 1.0, 1.0, 1.0 ],
          "bindings": [
            { "binding_name": "#progress_text" }
          ]
        }
      }
    ]
  },


  // Canel Button
  "new_cancel_button@button_preset.facelift_button_base": {
    "size": [ 100, 26 ],
    "anchor_from": "center",
    "anchor_to": "center",

    "$text": "gui.cancel",
    "$pressed_button_name": "button.menu_exit",
    "$button_type_panel": "button_content_preset.text_content_panel",

    "bindings": [
      {
        "binding_name": "#cancel_visible",
        "binding_name_override": "#visible"
      }
    ]
  },


  // World Modal Progress
  "world_modal_progress_panel": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "variables": [
      {
        "requires": "$desktop_screen",
        "$button_state_default_base": "common.button_state_default",
        "$button_state_hover_base": "common.button_state_hover",
        "$button_state_pressed_base": "common.button_state_pressed"
      },
      {
        "requires": "$pocket_screen",
        "$button_state_default_base": "common-classic.button_state_default",
        "$button_state_hover_base": "common-classic.button_state_hover",
        "$button_state_pressed_base": "common-classic.button_state_pressed"
      }
    ],
    "controls": [
      {
        "content_panel": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "base_content": {
                "layer": 15,
                "type": "stack_panel",
                "size": [ "100%", "100%c" ],
                "controls": [
                  {
                    "stack_panel": {
                      "type": "panel",
                      "size": [ "100%", "100%cm" ],
                      "controls": [
                        {
                          "progress_title_text_panel": {
                            "type": "panel",
                            "size": [ "90%", "100%c" ],
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "controls": [
                              {
                                "progress_text@progress.progress_title_world_panel": {
                                  "anchor_from": "center",
                                  "anchor_to": "center"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "void_panel@common.empty_panel": {
                      "size": [ 0, 8 ],
                      "bindings": [
                        {
                          "binding_name": "#loading_bar_visible",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "fancy_progress_loading_bars_panel": {
                      "type": "panel",
                      "size": [ "100%", "100%c + 2px" ],
                      "controls": [
                        {
                          "fancy_progress_loading_bars@progress.fancy_progress_loading_bars": {
                            "anchor_from": "center",
                            "anchor_to": "center"
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_name": "#loading_bar_visible",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}