                "controls": [
                  { "text": { "type": "label", "size": "$text_size", "max_size": "$text_max_size", "text": "$text", "text_alignment": "$text_alignment", "color": "$text_color", "anchor_from": "center", "anchor_to": "center" } }
                ]
              }
            }
          ]
        }
      },
      { "void_padding@common.empty_panel": { "ignored": "(not $has_option_description)", "size": [ 0, 4 ] } },
      {
        "option_descriptive_text_0": {
          "ignored": "(not $has_option_description)",
          "layer": 10,
          "type": "label",
          "size": [ "100%", "default" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "text": "$option_description",
          "text_alignment": "left",
          "color": "$option_description_text_color",
          "locked_alpha": 0.75
        }
      }
    ]
  },


  // Ore Icon Button Content
  "ore_icon_button_content": {
    "$use_highlight_border|default": true,
    "$use_pressed_offset|default": true,

    "type": "panel",
    "size": [ "100%", "100%" ],
    "$glyph_size|default": [ "80%", "80%" ],
    "$content_offset|default": [ 0, 0 ],
    "$glyph_offset|default": [ 0, 0 ],
    "$glyph_anchor_from|default": "center",
    "$glyph_anchor_to|default": "center",
    "$glyph_texture|default": "textures/ui/empty",
    "variables": [
      {
        "requires": "($use_pressed_offset and $pressed_state)",
        "$content_offset": [ 0, 2 ]
      }
    ],
    "layer": 2,
    "offset": "$content_offset",
    "controls": [
      {
        "highlight@common_ore.icon_highlight": {
          "$highlight_bindings|default": [],

          "layer": 5,
          "visible": "($use_highlight_border and $pressed_state)",
          "size": "$glyph_size",
          "offset": "$glyph_offset",
          "anchor_from": "$glyph_anchor_from",
          "anchor_to": "$glyph_anchor_to",
          "bindings": "$highlight_bindings"
        }
      },
      {
        "glyph": {
          "$glyph_bindings|default": [],

          "layer": 3,
          "visible": "(not $use_highlight_border)",
          "type": "image",
          "size": "$glyph_size",
          "offset": "$glyph_offset",
          "anchor_from": "$glyph_anchor_from",
          "anchor_to": "$glyph_anchor_to",
          "texture": "$glyph_texture",
          "color": "$glyph_color",
          "alpha": "$content_alpha",
          "bindings": "$glyph_bindings"
        }
      },
      {
        "glyph_color": {
          "$glyph_color_bindings|default": [],

          "layer": 4,
          "type": "image",
          "size": "$glyph_size",
          "offset": "$glyph_offset",
          "anchor_from": "$glyph_anchor_from",
          "anchor_to": "$glyph_anchor_to",
          "texture": "$glyph_color_texture",
          "alpha": "$content_alpha",
          "bindings": "$glyph_color_bindings"
        }
      },
      {
        "button_text_panel": {
          "visible": "($toggle_unchecked_hover or $toggle_checked_hover)",
          "type": "panel",
          "size": [ "100%", "100%" ],
          "controls": [
            {
              "button_text_background": {
                "layer": 40,
                "type": "image",
                "size": [ "100%c + 8px", "100%c + 8px" ],
                "offset": [ 0, -28 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "texture": "textures/ui/hud_tip_text_background",
                "alpha": 0.8,
                "controls": [
                  {
                    "button_text": {
                      "layer": 42,
                      "type": "label",
                      "size": [ "default", "default" ],
                      "max_size": [ "default", "default" ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "text": "$button_text",
                      "font_scale_factor": 1.1,
                      "shadow": true
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },


  // Sidebar Icon
  "sidebar_icon_button_content_panel": {
    "type": "stack_panel",
    "size": [ "100%", "100%" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "orientation": "horizontal",

    "$icon_size|default": [ "100%", "100%" ],
    "$icon_offset|default": [ 0, 0 ],
    "$icon_path|default": "",
    "$icon_color|default": [ 1.0, 1.0, 1.0 ],
    "$text|default": "",
    "$text_color|default": [ 1.0, 1.0, 1.0 ],

    "controls": [
      {
        "icon_panel": {
          "type": "panel",
          "size": [ "100%y", "100%" ],
          "controls": [
            {
              "icon": {
                "type": "image",
                "size": "$icon_size",
                "offset": "$icon_offset",
                "texture": "$icon_path",
                "color": "$icon_color",
                "anchor_from": "center",
                "anchor_to": "center"
              }
            }
          ]
        }
      },
      {
        "text_panel": {
          "type": "panel",
          "size": [ "fill", "100%" ],
          "controls": [
            {
              "text": {
                "type": "label",
                "size": [ "default", "default" ],
                "max_size": [ "100%", "100%" ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "text": "$text",
                "text_alignment": "left",
                "color": "$text_color",
                "shadow": true
              }
            }
          ]
        }
      }
    ]
  },


  // New Dynamic Start Button Content
  "new_ui_form_fitting_button_panel": {
    "layer": 1,
    "type": "panel",
    "size": "$button_size_override",
    "$button_size_override|default": [ "100%c", "100%c" ],
    "$border_visible|default": true,
    "$focus_border_size_override|default": [ "100%c + 2px", "100%c + 2px" ],
    "$button_image_size_override|default": [ "100%c + 2px", "100%c + 2px" ],
    "$button_content_size_override|default": [ "100%c + 6px", "100%c + 6px" ],

    "$content_alpha|default": 1,
    "anchor_from": "$anchor",
    "anchor_to": "$anchor",
    "controls": [
      {
        "border@common_buttons.focus_border": {
          "visible": "$border_visible",
          "layer": "$border_layer",
          "size": [ "100%sm", "100%sm" ],
          "color": "$border_color"
        }
      },
      {
        "button_content": {
          "type": "panel",
          "size": "$focus_border_size_override",
          "$button_image|default": "common_buttons.button_image",
          "controls": [
            {
              "$button_image@$button_image": {
                "size": "$button_image_size_override",
                "$form_fitting_min_size|default": [ 0, 0 ],
                "min_size": "$form_fitting_min_size",
                "layer": 1,
                "controls": [
                  {
                    "button_content": {
                      "type": "panel",
                      "size": "$button_content_size_override",
                      "controls": [
                        {
                          "$button_type_panel@$button_type_panel": {
                            "layer": 3
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },


  // Dynamic Upgrade Button Content
  "dynamic_upgrade_button_background_base": {
    "type": "image",
    "size": [ "100%", "100%" ],
    "fill": true,
    "texture": "$button_background_image"
  },

  "binding_dynamic_upgrade_button_background_base": {
    "type": "image",
    "size": [ "100%", "100%" ],
    "fill": true,
    "$texture_path|default": "",
    "$texture_file_system|default": "",
    "bindings": [
      {
        "binding_name": "$texture_path",
        "binding_name_override": "#texture"
      },
      {
        "binding_name": "$texture_file_system",
        "binding_name_override": "#texture_file_system"
      }
    ]
  },

  "profile_image_dynamic_upgrade_button_background_base": {
    "type": "custom",
    "size": [ "100%", "100%" ],
    "renderer": "profile_image_renderer",
    "bindings": [
      {
        "binding_name": "#profile_image_options"
      }
    ]
  },

  "dynamic_upgrade_button_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
