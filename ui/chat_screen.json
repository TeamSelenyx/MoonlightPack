{
  "namespace": "chat",

  "setting_text": {
    "type": "label",
    "size": [ "100%", "default" ],
    "text": "options.chat.title",
	"text_alignment": "center",
	"color": "$title_text_color"
  },


  // Chat Function Button Images //
  "down_arrow_image": {
    "type": "image",
    "size": [ 12, 8 ],
    "texture": "textures/ui/chat_down_arrow"
  },

  "keyboard_image": {
    "type": "image",
    "size": [ 13, 11 ],
    "texture": "textures/ui/chat_keyboard_hover"
  },

  "gear_image": {
    "type": "image",
    "size": [ 14, 14 ],
    "texture": "textures/ui/gear"
  },

  "previous_image": {
    "type": "image",
    "size": [ 13, 13 ],
    "texture": "textures/ui/chat_previous"
  },

  "next_image": {
    "type": "image",
    "size": [ 13, 13 ],
    "texture": "textures/ui/chat_next"
  },

  "autocomplete_back_image": {
    "type": "image",
    "size": [ 14, 14 ],
    "texture": "textures/ui/chat_autocomplete_back"
  },

  "autocomplete_image": {
    "type": "image",
    "size": [ 14, 14 ],
    "texture": "textures/ui/chat_autocomplete"
  },

  "send_image": {
    "type": "image",
    "size": [ 21, 18 ],
    "offset": [ 0, 1 ],
    "texture": "textures/ui/chat_send"
  },

  "send_panel": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ 44, 18 ],
    "controls": [
      {
        "send_image_panel": {
          "type": "panel",
          "size": [ "fill", "100%c" ],
          "controls": [
            { "send_image@send_image": {} }
          ]
        }
      },
      {
        "gamepad_x_button": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ 23, "100%" ],
          "controls": [
            {
              "side_padding": {
                "type": "panel",
                "size": [ 2, "100%" ]
              }
            },
            {
              "gamepad_x_button_image": {
                "type": "panel",
                "controls": [
                  {
                    "icon@common.gamepad_helper_x": {
                      "$icon_description_bind_type": "none"
                    }
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#gamepad_helper_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "keyboard_image_panel": {
    "type": "panel",
    "controls": [
      {
        "keyboard_image@chat.keyboard_image": {
          "bindings": [
            {
              "binding_name": "(not #keyboard_being_used)",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "down_arrow_image@chat.down_arrow_image": {
          "bindings": [
            {
              "binding_name": "#keyboard_being_used",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },


  // Chat Text Edit //
  "facelift_text_edit_box@common.text_edit_box": {
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ "100% - 4px", 26 ],
    "max_length": "$max_text_edit_length",

    "always_listening": true,

    "$text_box_name": "#message_text_box",
    "$text_edit_box_content_binding_name": "#message_text_box_content",
    
    "$place_holder_text": "chat.text_edit_box.description",

    "default_focus_precedence": 1,
    "$focus_id": "text_edit_box_focus_id",
    "$focus_override_right": "keyboard_button_focus_id",
    "$focus_override_left": "chat_settings_button_focus_id",
    "$text_box_tts_header": "accessibility.chat.tts.textboxTitle",
    "$text_box_tts_name": "",

    "$text_background_default": "common.empty_panel",
    "$text_background_hover": "common.empty_panel",
    "$text_offset": [ 0, 0 ],

    "bindings": [
      {
        "binding_type": "$text_edit_box_enabled_binding_type",
        "binding_collection_name": "$text_edit_box_grid_collection_name",
        "binding_name": "$text_box_enabled_binding_name",
        "binding_name_override": "#enabled"
      },
      {
        "binding_name": "#text_edit_box_focus_override_up",
        "binding_name_override": "#focus_change_up"
      },
      {
        "binding_name": "#text_edit_box_focus_override_down",
        "binding_name_override": "#focus_change_down"
      }
    ],

    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": true,
        "handle_deselect": true,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": false,
        "handle_deselect": true,
        "mapping_type": "global",
        "consume_event": false
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": true,
        "handle_deselect": true,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": false,
        "handle_deselect": true,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "$text_edit_box_deselected_to_button_id",
        "handle_select": false,
        "handle_deselect": true,
        "mapping_type": "global"
      },
      {
        "to_button_id": "$text_edit_box_hovered_button_id",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "$text_edit_box_clear_from_button_id",
        "to_button_id": "$text_edit_box_clear_to_button_id",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },

      // Extra Mappings //
      {
        "from_button_id": "button.menu_autocomplete",
        "to_button_id": "button.chat_autocomplete",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_autocomplete_back",
        "to_button_id": "button.chat_autocomplete_back",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_textedit_up",
        "to_button_id": "button.chat_previous_message",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.menu_textedit_down",
        "to_button_id": "button.chat_next_message",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "focused"
      },

      // Controller Mappings //
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.send",
        "mapping_type": "global",
        "handle_select": false,
        "handle_deselect": false
      },
      {
        "from_button_id": "button.controller_start",
        "to_button_id": "button.send",
        "mapping_type": "global",
        "handle_select": false,
        "handle_deselect": false
      },
      {
        "from_button_id": "button.controller_autocomplete",
        "to_button_id": "button.chat_autocomplete",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.controller_autocomplete_back",
        "to_button_id": "button.chat_autocomplete_back",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.controller_textedit_up",
        "to_button_id": "button.chat_previous_message",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.controller_textedit_down",
        "to_button_id": "button.chat_next_message",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.chat_paste_coordinates",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "global"
      }
    ]
  },


  // Commands Background //
  "commands_background": {
    "type": "image",
    "size": [ "100%", "100%c" ],
    "texture": "textures/ui/White",
    "color": [ 0.0, 0.0, 0.0 ]
  },


  // Auto Complete //
  "auto_complete_panel_contents_with_item": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "100%", 12 ],
    "controls": [
      {
        "auto_complete_item_renderer@common.item_renderer": {
          "size": [ 9, 9 ],
          "offset": [ 2, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#auto_complete_item",
              "binding_type": "collection",
              "binding_name_override": "#item_id_aux",
              "binding_collection_name": "auto_complete"
            }
          ]
        }
      },
      {
        "text": {
          "type": "label",
          "color": "$chat_text_color",
          "offset": [ 2, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "text": "#text",
          "localize": false,
          "bindings": [
            {
              "binding_type": "collection",
              "binding_name": "#auto_complete_text",
              "binding_name_override": "#text",
              "binding_collection_name": "auto_complete"
            }
          ]
        }
      },
      {
        "autocomplete_button@common.button": {
          "$pressed_button_name": "button.click_autocomplete",
          "tts_inherit_siblings": true,
          "controls": [
            { "default": { "type": "panel" } },
            { "hover@chat.click_autocomplete_is_focused": {} },
            { "pressed@chat.click_autocomplete_is_focused": {} }
          ],
          "bindings": [
            {
              "binding_type": "collection",
              "binding_name": "#is_autocomplete_suggestion",
              "binding_name_override": "#visible",
              "binding_collection_name": "auto_complete"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "auto_complete"
            }
          ]
        }
      }
    ]
  },

  "auto_complete_panel": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "controls": [
      {
        "panel": {
          "type": "panel",
          "size": [ "100%", "100%" ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "controls": [
            {
              "auto_complete_grid": {
                "type": "grid",
                "size": [ "100%", "100%" ],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "grid_item_template": "chat.auto_complete_panel_contents_with_item",
                "grid_fill_direction": "vertical",
                "collection_name": "auto_complete",
                "bindings": [
                  {
                    "binding_name": "#get_grid_size",
                    "binding_type": "collection",
                    "binding_collection_name": "auto_complete"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },


  // Commands Stack Panel //
  "commands_panel": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "offset": [ 0, 0 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "auto_complete_panel@chat.auto_complete_panel": {
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left"
        }
      }
    ]
  },


  // Messages Panel //
  "facelift_messages_stack_panel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "$scrolling_content_anchor_from": "bottom_left",
    "$scrolling_content_anchor_to": "bottom_left",
    "factory": {
      "name": "messages_factory",
      "max_children_size": 250,
      "control_ids": {
        "chat_screen_messages": "chat_screen_messages@chat.message_tts_wrapper"
      }
    }
  },

  "facelift_messages_scrolling_panel@common.scrolling_panel": {
    "type": "panel",
    "size": [ "100% - 4px", "100%" ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "offset": [ 2, 0 ],
    "$scrolling_content": "chat.facelift_messages_stack_panel",
    "$scroll_size": [ 5, "100% - 4px" ],
    "$jump_to_bottom_on_update": false,
    "$show_background": false,
    "$always_handle_scrolling": true
  },


  // Coordinates //
  "coordinate_dropdown_content": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "$focus_id": "coordinate_dropdown_focus_id",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "top_padding@common.empty_panel": {
          "size": [ "100%", 2 ]
        }
      },
      {
        "my_position@settings_common.radio_item_with_label_and_content": {
          "$toggle_state_binding_name": "#coordinate_type_position",
          "$radio_label_text": "chat.coordinateTypePosition"
        }
      },
      {
        "block_position@settings_common.radio_item_with_label_and_content": {
          "$toggle_state_binding_name": "#coordinate_type_facing",
          "$radio_label_text": "chat.coordinateTypeFacing"
        }
      },
      {
        "bottom_padding@common.empty_panel": {
          "size": [ "100%", 2 ]
        }
      }
    ]
  },

  "facelift_coordinate_dropdown@settings_common.facelift_option_dropdown_no_scroll": {
    "$show_option_label": false,
    "$dropdown_area": "chat_header_content_area",
    "$dropdown_name": "chat_coordinate_dropdown",
    "$options_dropdown_toggle_label_binding": "#chat_coordinate_dropdown_label",
    "$option_dropdown_size": [ "100%", 16 ],
    "$options_dropdown_toggle_button_state_content": [ "100%", "100%" ],
    "$dropdown_scroll_content_offset": [ 0, 17 ],
    "$dropdown_content": "chat.coordinate_dropdown_content"
  },

  "copy_coordinate_button@chat.small_button": {
    "$button_content": "chat.copy_image",
    "$pressed_button_name": "copy_coordinates_button",
    "$focus_id": "coordinate_copy_button_focus_id",
    "$focus_override_left": "coordinate_dropdown_focus_id",
    "$focus_override_right": "paste_button_focus_id",
    "$focus_override_down": "text_edit_box_focus_id",
    "bindings": [
      {
        "binding_name": "#copy_button_enabled",
        "binding_name_override": "#enabled"
      }
    ]
  },

  "paste_button@chat.small_button": {
    "$button_content": "chat.paste_image",
    "$pressed_button_name": "paste_button",
    "$focus_id": "paste_button_focus_id",
    "$focus_override_left": "coordinate_copy_button_focus_id",
    "$focus_override_down": "text_edit_box_focus_id"
  },

  "popup_toast@persona.popup": {
    "layer": 100,
    "$display_time": 0.75,
    "$transition_in_time": 0.15,
    "$transition_out_time": 0.15,
    "$popup_size": [ 40, 20 ],
    "$toast_text_offset": [ 0, 4 ],
    "$toast_text_alignment": "center",
    "$toast_anchor_from": "top_center",
    "$toast_anchor_to": "top_center",
    "$toast_font_type": "smooth",
    "$offset_anims": [],
    "$alpha_anims": []
  },


  // Facelift Design //
  "keyboard_facelift_button@button_preset.facelift_button_base": {
    "size": [ 26, 26 ],
    "$button_type_panel": "button_content_preset.facelift_button_content_panel",
    "$content": "chat.keyboard_image_panel",

    "$pressed_button_name": "button.keyboard_toggle",
    "$focus_id": "keyboard_button_focus_id",
    "$button_tts_header": "accessibility.chat.tts.keyboard",
    "bindings": [
      {
        "binding_name": "#keyboard_button_focus_override_up",
        "binding_name_override": "#focus_change_up"
      },
      {
        "binding_name": "#keyboard_button_focus_override_down",
        "binding_name_override": "#focus_change_down"
      }
    ]
  },

  "chat_previous_facelift_button@button_preset.facelift_button_base": {
    "size": [ 26, 26 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "$button_type_panel": "button_content_preset.facelift_button_content_panel",
    "$content": "chat.previous_image",
    "$pressed_button_name": "button.chat_previous_message",

    "$default_button_texture": "textures/ui/facelift/facelift_button_full_horizontal",
    "$hover_button_texture": "textures/ui/facelift/facelift_button_full_horizontal",
    "$pressed_button_texture": "textures/ui/facelift/facelift_button_full_horizontal",
    "$locked_button_texture": "textures/ui/facelift/facelift_button_full_horizontal"
  },

  "cheat_chat_previous_facelift_button@button_preset.facelift_button_base": {
    "size": [ 26, 26 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "$button_type_panel": "button_content_preset.facelift_button_content_panel",
    "$content": "chat.previous_image",
    "$pressed_button_name": "button.chat_previous_message",

    "$default_button_texture": "textures/ui/facelift/facelift_button_left",
    "$hover_button_texture": "textures/ui/facelift/facelift_button_left",
    "$pressed_button_texture": "textures/ui/facelift/facelift_button_left",
    "$locked_button_texture": "textures/ui/facelift/facelift_button_left"
  },

  "chat_next_facelift_button@button_preset.facelift_button_base": {
    "size": [ 26, 26 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "$button_type_panel": "button_content_preset.facelift_button_content_panel",
    "$content": "chat.next_image",
    "$pressed_button_name": "button.chat_next_message",

    "$default_button_texture": "textures/ui/facelift/facelift_button_right",
    "$hover_button_texture": "textures/ui/facelift/facelift_button_right",
    "$pressed_button_texture": "textures/ui/facelift/facelift_button_right",
    "$locked_button_texture": "textures/ui/facelift/facelift_button_right"
  },

  "chat_autocomplete_back_facelift_button@button_preset.facelift_button_base": {
    "size": [ 26, 26 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "$button_type_panel": "button_content_preset.facelift_button_content_panel",
    "$content": "chat.autocomplete_back_image",
    "$pressed_button_name": "button.chat_autocomplete_back",

    "$default_button_texture": "textures/ui/facelift/facelift_button_left",
    "$hover_button_texture": "textures/ui/facelift/facelift_button_left",
    "$pressed_button_texture": "textures/ui/facelift/facelift_button_left",
    "$locked_button_texture": "textures/ui/facelift/facelift_button_left"
  },

  "chat_autocomplete_facelift_button@button_preset.facelift_button_base": {
    "size": [ 26, 26 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "$button_type_panel": "button_content_preset.facelift_button_content_panel",
    "$content": "chat.autocomplete_image",
    "$pressed_button_name": "button.chat_autocomplete",

    "$default_button_texture": "textures/ui/facelift/facelift_button_right",
    "$hover_button_texture": "textures/ui/facelift/facelift_button_right",
    "$pressed_button_texture": "textures/ui/facelift/facelift_button_right",
    "$locked_button_texture": "textures/ui/facelift/facelift_button_right"
  },

  "send_facelift_button@button_preset.facelift_button_base": {
    "size": [ 44, 26 ],
    "$anchor": "bottom_right",
    "$pressed_button_name": "button.send",
    "$tts_enabled|default": true,
    "focus_enabled": "$tts_enabled",

    "$button_tts_header": "accessibility.chat.tts.sendChatMessage",
    "$button_type_panel": "button_content_preset.facelift_button_content_panel",
    "$content": "chat.send_panel",
    "bindings": [
      {
        "binding_name": "#send_button_visible",
        "binding_name_override": "#button_enabled"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#button_enabled or #toggle_enabled)",
        "target_property_name": "#enabled"
      }
    ]
  },

  "chat_settings_facelift_button@button_preset.facelift_button_base": {
    "$pressed_button_name": "button.open_chat_settings",

    "$button_type_panel": "button_content_preset.facelift_button_only_icon_content_panel",
    "$icon_path": "textures/ui/settings_glyph_2x",

    "$focus_id": "chat_settings_button_focus_id",
    "$button_tts_header": "chat.settings"
  },

  "facelift_chat_coordinate_content": {
    "type": "panel",
    "size": [ "100%c", "100%" ],
    "offset": [ 0, 0 ],
    "anchor_to": "center",
    "anchor_from": "center",
    "bindings": [
      {
        "binding_name": "#chat_coordinate_dropdown_visible",
        "binding_name_override": "#visible",
        "binding_type": "global"
      }
    ],
    "controls": [
      {
        "chat_coordinate_backgorund": {
          "type": "image",
          "size": [ "100%c + 8px", "100%" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "texture": "$facelift_texture",
          "color": "$facelift_texture_default_color",
          "alpha": "$facelift_texture_alpha",
          "controls": [
            {
              "chat_header_content_area": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "size": [ "100%c", "100% - 4px" ],
                "offset": [ 0, 2 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "coordinate_dropdown@chat.facelift_coordinate_dropdown": { "size": [ 100, 20 ] }
                  },
                  {
                    "coordinates_panel": {
                      "type": "panel",
                      "size": [ "100%c", 16 ],
                      "controls": [
                        {
                          "coordinates_background_image": {
                            "layer": 1,
                            "type": "image",
                            "anchor_to": "center",
                            "anchor_from": "center",
                            "size": [ "100%c + 14px", 12 ],
                            "min_size": [ 160, 12 ],
                            "texture": "textures/ui/lightgreybars",
                            "controls": [
                              {
                                "coordinates_text": {
                                  "type": "label",
                                  "size": [ "default", 10 ],
                                  "text": "#text",
                                  "color": "$main_header_text_color",
                                  "layer": 2,
                                  "bindings": [
                                    {
                                      "binding_name": "#coordinates_text",
                                      "binding_name_override": "#text"
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "copy_coordinate_button@chat.copy_coordinate_button": { "size": [ 16, 16 ] }
                  },
                  {
                    "paste_button@chat.paste_button": { "size": [ 16, 16 ] }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },


  "facelift_chat_header": {
    "type": "panel",
    "size": [ "100%", "100%cm" ],
    "offset": [ 0, 0 ],
    "anchor_to": "top_middle",
    "anchor_from": "top_middle",
    "$back_button_text": "controller.buttonTip.back",
    "controls": [
      {
        "popup_dialog_panel": {
          "type": "panel",
          "size": [ "100%", "100%sm" ],
          "controls": [
            {
              "popup_dialog_factory": {
                "type": "factory",
                "control_ids": {
                  "toast_message": "@chat.popup_toast"
                }
              }
            }
          ]
        }
      },
      {
        "back_button_panel": {
          "type": "stack_panel",
          "size": [ "100%c", "100%cm" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "orientation": "horizontal",
          "controls": [
            {
              "back_button_content": {
                "layer": 5,
                "type": "panel",
                "size": [ "100%c", "100%c" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "back_button@button_preset.back_button": {
                      "layer": 6
                    }
                  }
                ]
              }
            },
            { "void_padding@common.empty_panel": { "size": [ 4, 0 ] } },
            {
              "title_backgorund": {
                "type": "image",
                "size": [ "100%c", "100%sm" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "texture": "$facelift_texture",
                "color": "$facelift_texture_default_color",
                "alpha": "$facelift_texture_alpha",
                "controls": [
                  {
                    "title_panel": {
                      "type": "panel",
                      "size": [ "100%c + 18px", "100% - 4px" ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "controls": [
                        {
                          "title": {
                            "layer": 6,
                            "type": "label",
                            "size": [ "default", "default" ],
                            "max_size": [ "default", "100%" ],
                            "text": "#text",
                            "offset": [ 0, 0 ],
                            "color": [ 1.0, 1.0, 1.0 ],
                            "bindings": [
                              {
                                "binding_name": "#chat_title_text",
                                "binding_name_override": "#text"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "chat_function_panel": {
          "type": "stack_panel",
          "size": [ "100%c", "100%sm" ],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "orientation": "horizontal",
          "controls": [
            { "chat_header_content_area@chat.facelift_chat_coordinate_content": {} },
            { "chat_settings_void_padding@common.empty_panel": { "size": [ 4, 0 ] } },
			{
			  "chat_settings_panel": {
                "type": "panel",
                "size": [ "100%c", "100%" ],
                "controls": [
                  {
                    "chat_settings@chat.chat_settings_facelift_button": {
                      "size": [ "100%y", "100%" ],
                      "offset": [ 0, 0 ],
                      "anchor_from": "center",
                      "anchor_to": "center"
                    } 
                  }
                ]
              } 
			}
          ]
        }
      }
    ]
  },


  // Chat Screen //
  "chat_screen": {
    "$is_full_screen_layout": true,
    "$fill_alpha": 0.0,

    "$screen_animations": [
      "@common.screen_exit_animation_push_fade",
      "@common.screen_exit_animation_pop_fade",
      "@common.screen_entrance_animation_push_fade",
      "@common.screen_entrance_animation_pop_fade"
    ]
  },

  "chat_screen_content": {
    "type": "panel",
    "controls": [
      {
        "chat_content": {
          "type": "stack_panel",
          "size": [ "100% - 8px", "100% - 8px" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            { "chat_top_panel@chat.facelift_chat_header": { "layer": 2 } },
            { "start_messages_panel_padding@common.empty_panel": { "size": [ 0, 2 ] } },
            {
              "messages_autocomplete_commands_panel": {
                "type": "panel",
                "size": [ "100%", "fill" ],
                "controls": [
                  { "messages_panel@chat.facelift_messages_scrolling_panel": {} },
                  { "autocomplete_commands_panel@chat.commands_panel": { "layer": 3 } }
                ]
              }
            },
            { "end_messages_panel_padding@common.empty_panel": { "size": [ 0, 2 ] } },
            { "chat_bottom_panel@chat.facelift_chat_bottom_panel": { "layer": 2 } }
          ]
        }
      },
      { "host_main_panel@host_options.host_panel": { "layer": 4 } },
      { "popup_factory@chat_settings.popup_factory": {} }
    ]
  },

  "facelift_chat_bottom_panel": {
    "type": "panel",
    "size": [ "100%", 26 ],
    "controls": [
      {
        "chat_bottom_panel": {
          "type": "stack_panel",
          "size": [ "100%", 26 ],
          "min_size": [ "100%", 26 ],
          "offset": [ 0, 0 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "orientation": "horizontal",
          "controls": [
            { "keyboard_button@chat.keyboard_facelift_button": {} },
            { "keyboard_button_padding@common.empty_panel": { "size": [ 4, 0 ] } },

            { "host_main_button@host_options.host_main_facelift_button": { "ignored": "$is_pregame", "$focus_override_up": "coordinate_dropdown_focus_id" } },
            {
              "chat_previous_divider@facelift_setting_utils.content_divider_base": {
                "$divider_type": "vertical",
                "bindings": [
                  {
                    "binding_name": "#cheats_on",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "chat_previous@chat.chat_previous_facelift_button": {
                "bindings": [
                  {
                    "binding_name": "#cheats_on",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "cheat_chat_previous@chat.cheat_chat_previous_facelift_button": {
                "bindings": [
                  {
                    "binding_name": "(not #cheats_on)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "chat_next_divider@facelift_setting_utils.content_divider_base": {
                "$divider_type": "vertical"
              }
            },
            { "chat_next@chat.chat_next_facelift_button": {} },

            { "start_text_box_padding@common.empty_panel": { "size": [ 4, 0 ] } },
            {
              "chat_text_box_panel": {
                "type": "image",
                "size": [ "fill", "100%" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "texture": "$facelift_texture",
                "color": "$facelift_texture_default_color",
                "alpha": "$facelift_texture_alpha",
                "controls": [
                  {
                    "chat_text_box": {
                      "type": "label",
                      "size": [ "100%", "100%" ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "controls": [
                        { "text_box@chat.facelift_text_edit_box": {} }
                      ]
                    }
                  }
                ]
              }
            },
            { "end_text_box_padding@common.empty_panel": { "size": [ 4, 0 ] } },

            { "chat_autocomplete_back@chat.chat_autocomplete_back_facelift_button": {} },
            {
              "chat_autocomplete_divider@facelift_setting_utils.content_divider_base": {
                "$divider_type": "vertical"
              }
            },
            { "chat_autocomplete@chat.chat_autocomplete_facelift_button": {} },

            { "send_button_padding@common.empty_panel": { "size": [ 4, 0 ] } },
            { "send_button@chat.send_facelift_button": { "offset": [ -20, 0 ] } }
          ]
        }
      }
    ]
  }
}