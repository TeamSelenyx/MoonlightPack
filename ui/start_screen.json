  //---------------------------------------------------------------------------
  // Start Screen: Dynamic & Function Button Base
  //---------------------------------------------------------------------------
  "start_dynamic_button_base@button_preset.facelift_button_base": {
    "size": [ "fill", "100%" ],
    "$button_type_panel": "start.redesign_start_dynamic_button_content"
  },

  "redesign_start_dynamic_button_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$visible_inbox_unread_icon|default": false,
    "$visible_gathering_icon|default": false,
    "$text_font_scale_factor|default": 1.0,
    "$content_controls": [
      {
        "inbox_unread_icon": {
          "layer": 4,
          "ignored": "(not $visible_inbox_unread_icon)",
          "type": "image",
          "size": [ 8, 8 ],
          "offset": [ -4, 0 ],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "texture": "textures/ui/red_dot",
          "bindings": [
            {
              "binding_name": "#unread_notification_icon"
            },
            {
              "binding_name": "#unread_notification_icon_visibility",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "gathering_icon": {
          "layer": 4,
          "ignored": "(not $visible_gathering_icon)",
          "type": "image",
          "size": [ 8, 8 ],
          "offset": [ -4, 0 ],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "texture": "textures/ui/icon_new_item",
          "bindings": [
            {
              "binding_name": "#unread_notification_icon"
            },
            {
              "binding_name": "#unread_notification_icon_visibility",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "locked_icon": {
          "layer": 4,
          "ignored": "(not $locked_state)",
          "type": "image",
          "size": [ 16, 16 ],
          "offset": [ -4, 0 ],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "texture": "textures/ui/icon_lock"
        }
      },
      {
        "button_content": {
          "layer": 4,
          "type": "stack_panel",
          "size": [ "100% - 4px", "100% - 4px" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "orientation": "horizontal",
          "controls": [
            {
              "icon_panel": {
                "type": "panel",
                "size": [ "100%y", "100%" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "$button_icon_background|default": "textures/ui/hud_mob_effect_background",
                "$button_icon_background_color|default": [ 1.0, 1.0, 1.0 ],
                "controls": [
                  {
                    "icon_cover": {
                      "layer": 4,
                      "type": "image",
                      "size": [ "90%", "90%" ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "texture": "$button_icon_background",
                      "color": "$button_icon_background_color",
                      "$button_icon|default": "start.none_icon",
                      "$button_icon_color|default": [ 1.0, 1.0, 1.0 ],
                      "controls": [
                        {
                          "icon@$button_icon": {
                            "layer": 6,
                            "size": [ "80%", "80%" ],
                            "anchor_from": "center",
                            "anchor_to": "center"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            { "void_panel@common.empty_panel": { "size": [ 4, 0 ] } },
            {
              "button_text_panel": {
                "type": "panel",
                "size": [ "fill", "100%" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "button_text@common_buttons.new_ui_binding_button_label": {
                      "$text_alignment": "left",
                      "$button_font_scale_factor": "$text_font_scale_factor",
                      "$button_text_size": [ "100%", "default" ],
                      "$button_text_max_size": [ "100%", "default" ],
                      "shadow": true
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "controls": "$content_controls"
  },

  "redesign_start_dynamic_button_content_v2@start.redesign_start_dynamic_button_content": {
    "$button_background_image_path|default": "textures/ui/empty",
    "$content_controls": [
      {
        "locked_icon": {
          "layer": 4,
          "ignored": "(not $locked_state)",
          "type": "image",
          "size": [ 16, 16 ],
          "offset": [ 0, 0 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "texture": "textures/ui/icon_lock"
        }
      },
      {
        "button_content": {
          "layer": 8,
          "type": "stack_panel",
          "size": [ "100% - 4px", "100%cm + 4px" ],
          "offset": [ 4, 4 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "orientation": "horizontal",
          "controls": [
            {
              "icon_panel": {
                "type": "panel",
                "size": [ "100%y", "100%sm" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "icon@$button_icon": {
                      "layer": 8,
                      "size": [ "95%", "95%" ],
                      "anchor_from": "center",
                      "anchor_to": "center"
                    }
                  }
                ]
              }
            },
            { "void_panel@common.empty_panel": { "size": [ 4, 0 ] } },
            {
              "button_text_panel": {
                "type": "panel",
                "size": [ "fill", "100%c" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "button_text": {
                      "layer": 8,
                      "type": "label",
                      "size": [ "100%", "default" ],
                      "max_size": [ "100%", "default" ],
                      "text_alignment": "left",
                      "font_scale_factor": "$text_font_scale_factor",
                      "text": "$button_text",
                      "shadow": true
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "background_image_content": {
          "layer": 4,
          "type": "panel",
          "size": [ "100% - 4px", "100% - 4px" ],
          "offset": [ 0, 0 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "background_image": {
                "layer": 4,
                "type": "image",
                "size": [ "95%", "95%" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "texture": "$button_background_image_path",
                "color": [ 0.7, 0.7, 0.7 ],
                "alpha": 0.6
              }
            }
          ]
        }
      }
    ]
  },

  "redesign_start_dynamic_button_content_v3@start.redesign_start_dynamic_button_content": {
    "$content_controls": [
      {
        "locked_icon": {
          "layer": 4,
          "ignored": "(not $locked_state)",
          "type": "image",
          "size": [ 16, 16 ],
          "offset": [ 0, 0 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "texture": "textures/ui/icon_lock"
        }
      },
      {
        "inbox_unread_icon": {
          "layer": 4,
          "ignored": "(not $visible_inbox_unread_icon)",
          "type": "image",
          "size": [ 8, 8 ],
          "offset": [ -4, 4 ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "texture": "textures/ui/red_dot",
          "bindings": [
            {
              "binding_name": "#unread_notification_icon"
            },
            {
              "binding_name": "#unread_notification_icon_visibility",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "gathering_icon": {
          "layer": 4,
          "ignored": "(not $visible_gathering_icon)",
          "type": "image",
          "size": [ 8, 8 ],
          "offset": [ -4, 4 ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "texture": "textures/ui/icon_new_item",
          "bindings": [
            {
              "binding_name": "#unread_notification_icon"
            },
            {
              "binding_name": "#unread_notification_icon_visibility",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "button_content": {
          "type": "stack_panel",
          "size": [ "100% - 4px", "100% - 4px" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "icon_panel": {
                "type": "panel",
                "size": [ "100%", "65%" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "icon@$button_icon": {
                      "size": [ "95%", "95%" ],
                      "anchor_from": "center",
                      "anchor_to": "center"
                    }
                  }
                ]
              }
            },
            { "void_panel@common.empty_panel": { "size": [ 0, 4 ] } },
            {
              "button_text_panel": {
                "type": "panel",
                "size": [ "100%", "fill" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "button_text": {
                      "type": "label",
                      "size": [ "100%", "default" ],
                      "max_size": [ "100%", "default" ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "text_alignment": "center",
                      "font_scale_factor": "$text_font_scale_factor",
                      "text": "$button_text",
                      "shadow": true
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

