                ]
              }
            },
            {
              "center_content_panel@facelift_setting_utils.animation_content_panel": {
                "$panel_size": [ "100%", "fill" ],
                "$content_panel_anims|default": [
                  "@anims_common.screen_exit_animation_push_size_super_dynamic_r",
                  "@anims_common.screen_exit_animation_pop_size_super_dynamic_r",
                  "@anims_common.screen_entrance_animation_push_size_super_dynamic",
                  "@anims_common.screen_entrance_animation_pop_size_super_dynamic",
                  "@common.screen_exit_animation_push_fade",
                  "@common.screen_exit_animation_pop_fade",
                  "@common.screen_entrance_animation_push_fade",
                  "@common.screen_entrance_animation_pop_fade"
                ],
                "$content_panel_controls": [
                  {
                    "center_content@common.horizontal_stack_panel": {
                      "size": [ "85%", "90%" ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "controls": [
                        {
                          "player_skin_view_panel": {
                            "type": "panel",
                            "size": [ "30%", "100%" ],
